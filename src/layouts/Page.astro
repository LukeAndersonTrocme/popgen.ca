---
// src/layouts/Page.astro
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.astro";
const {
	title,
	lang = "en",
	locale = "en",
	description = "PopGen Lab at Université de Montréal — computational genomics beyond boundaries.",
} = Astro.props;

// Get the current URL path for language switching
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.jpg" />
    <link rel="stylesheet" href="/styles/fonts.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="font-sans bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-50">
    <Navbar client:idle locale={locale} currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
