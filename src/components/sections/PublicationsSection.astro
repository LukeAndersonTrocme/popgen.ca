---
import publications from "../../data/publications.json";

const { locale = "en" } = Astro.props;

const featured = publications.slice(0, 4);

// A DOI under the 10.1101 prefix is a bioRxiv/medRxiv preprint.
const isPreprint = (p) => (p.doi || "").startsWith("10.1101");
const preprintLabel = locale === "fr" ? "Prépublication" : "Preprint";
---
<section
  id="publications"
  class="scroll-mt-24 py-20 bg-[#F7F9FC] dark:bg-slate-800 text-center"
>
  <h2 class="text-4xl font-bold">
    {locale === 'fr' ? 'Publications sélectionnées' : 'Selected Publications'}
  </h2>
  <ul class="mt-8 max-w-2xl mx-auto space-y-4 text-left px-4">
    {featured.map((p) => (
      <li class="border-l-4 border-primary pl-4">
        <a
          href={p.doi ? `https://doi.org/${p.doi}` : p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:underline"
        >
          <strong>{p.title}</strong>
        </a>
        <p class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-2">
          {isPreprint(p) && (
            <span class="inline-block text-[10px] font-bold uppercase tracking-wide text-amber-700 bg-amber-100 dark:text-amber-300 dark:bg-amber-900/40 px-1.5 py-0.5 rounded">
              {preprintLabel}
            </span>
          )}
          <span>
            {p.journal && <em>{p.journal}</em>}
            {p.journal && p.year ? ' · ' : ''}
            {p.year}
          </span>
        </p>
      </li>
    ))}
  </ul>
  <a
    href={locale === 'fr' ? '/fr/publications' : '/publications'}
    class="mt-8 inline-block text-primary hover:underline font-semibold"
  >
    {locale === 'fr' ? 'Voir toutes les publications →' : 'View all publications →'}
  </a>
</section>
