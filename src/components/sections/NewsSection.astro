---
import enData from "../../content/en/index.json";
import frData from "../../content/fr/index.json";
const { locale = "en" } = Astro.props;
const data = locale === "fr" ? frData : enData;
const { news } = data;
---
<section
  id="news"
  class="scroll-mt-24 py-20 bg-[#F7F9FC] dark:bg-slate-800 text-center"
>
  <h2 class="text-4xl font-bold">
    {locale === 'fr' ? 'Nouvelles' : 'News & Updates'}
  </h2>
  <ul class="mt-8 max-w-2xl mx-auto space-y-6 text-left px-4">
    {news.map((n) => (
      <li class="border-l-4 border-primary pl-4">
        <strong class="text-lg">{n.headline}</strong>
        <span class="ml-2 text-sm text-slate-500 dark:text-slate-400">{n.date}</span>
        <p class="mt-1 text-slate-700 dark:text-slate-300">{n.desc}</p>
      </li>
    ))}
  </ul>
</section>
