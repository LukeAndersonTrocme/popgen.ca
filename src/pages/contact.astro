---
import Page from "../layouts/Page.astro";
import data from "../content/en/index.json";
const { contact } = data;
---
<Page title="Contact – PopGen Lab" lang="en" locale="en" description="Contact the PopGen Lab at Université de Montréal.">
  <section class="py-12 max-w-4xl mx-auto px-4">
    <h1 class="text-4xl font-bold">Contact</h1>

    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="border-l-4 border-primary pl-6">
        <h2 class="text-xl font-semibold">Email</h2>
        <p class="mt-2 text-slate-700 dark:text-slate-300">{contact.email}</p>
      </div>

      <div class="border-l-4 border-primary pl-6">
        <h2 class="text-xl font-semibold">Address</h2>
        <p class="mt-2 text-slate-700 dark:text-slate-300">
          {contact.address.split('\n').map((line, i, arr) => (
            <>
              {line}
              {i < arr.length - 1 ? <br /> : null}
            </>
          ))}
        </p>
      </div>
    </div>
  </section>
</Page>
