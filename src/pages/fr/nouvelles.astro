---
import Page from "../../layouts/Page.astro";
import data from "../../content/fr/index.json";
const { news } = data;
---
<Page title="Nouvelles – Laboratoire PopGen" lang="fr" locale="fr" description="Nouvelles et mises à jour du Laboratoire PopGen à l'Université de Montréal.">
  <section class="py-12 max-w-4xl mx-auto px-4">
    <h1 class="text-4xl font-bold">Nouvelles</h1>
    <div class="mt-8 space-y-8">
      {news.map((n) => (
        <article class="border-l-4 border-primary pl-6">
          <h2 class="text-xl font-semibold">{n.headline}</h2>
          <time class="text-sm text-slate-500 dark:text-slate-400">{n.date}</time>
          <p class="mt-2 text-slate-700 dark:text-slate-300">{n.desc}</p>
        </article>
      ))}
    </div>
  </section>
</Page>
