---
import Page from "../layouts/Page.astro";
import Reveal from "../components/Reveal.jsx";
import Gallery from "../components/Gallery.jsx";

// Glob-import all Brian photos from src/assets/team/brian
const photoModules = import.meta.globEager(
	"../assets/team/brian/*.{jpg,jpeg,png,heic,HEIC}",
);
const slides = Object.entries(photoModules).map(([filePath, mod]) => ({
	src: mod.default,
	alt: `Brian photo: ${filePath.split("/").pop()}`,
}));

const locale = "en";
const title = "Brian";
const description =
	"Our official lab mascot and wellness officer 🐱. Enjoy these snapshots!";
---
<Page title={title} lang="en" locale={locale}>
  <Reveal client:load>
    <section class="py-20 text-center">
      <h1 class="text-5xl font-bold">{title}</h1>
      <p class="mt-4 mx-auto max-w-2xl">{description}</p>

      {/* React-powered lightbox gallery */}
      <Gallery slides={slides} client:load />
    </section>
  </Reveal>
</Page>